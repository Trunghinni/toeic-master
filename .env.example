# ─────────────────────────────────────────────────────────────
# TOEIC Master — Environment Variables Template
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────

# ── Database (Postgres) ──────────────────────────────────────
DATABASE_URL="postgresql://toeic:toeic_secret@localhost:5432/toeic_master"

# ── Redis ────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT Auth ─────────────────────────────────────────────────
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars_long"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars_long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Google OAuth2 (Phase 1) ───────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# ── App Configuration ────────────────────────────────────────
# NestJS API
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Next.js Frontend (NEXT_PUBLIC_ prefix = exposed to browser)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ── Email (Phase 1 — Forgot Password) ────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@toeicmaster.vn"

# ── AI Services (Phase 6) ─────────────────────────────────────
# Anthropic Claude (Writing grading)
ANTHROPIC_API_KEY=""

# OpenAI Whisper (Speaking STT)
OPENAI_API_KEY=""

# Azure Cognitive Services Speech (Alternative STT)
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"

# ── Object Storage / S3 (Phase 2+) ───────────────────────────
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_NAME="toeic-master-media"
S3_PUBLIC_URL=""

# ── Payment (Phase 8) ─────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# VNPay (alternative)
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# ── Error Tracking (Optional) ────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
